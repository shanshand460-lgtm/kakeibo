      <span class="ai-badge" id="ai-badge">✨ AI読み取り完了</span>
      <div id="ai-body"><div class="ai-amount" id="ai-amount">¥0</div><div class="ai-tags" id="ai-tags"></div></div>
    </div>
  </div>
</div>

<!-- IMPORT -->
<div id="s-import" class="screen">
  <div class="hdr"><span class="hdr-title">CSV取り込み</span></div>
  <div class="scroll-body">
    <div class="field"><label>カード会社</label></div>
    <div class="card-grid" id="card-grid"></div>
    <div class="how-to" id="how-to-box">
      <div class="how-to-title" id="how-to-title"></div>
      <ol id="how-to-steps"></ol>
    </div>
    <label style="cursor:pointer;display:block;" for="csv-input">
      <div class="csv-drop">
        📄
        <span class="lbl">CSVファイルを選択</span>
        <span class="sub">カード明細CSVをそのまま読み込めます</span>
      </div>
    </label>
    <input type="file" id="csv-input" accept=".csv,text/csv" onchange="onCsvSelected(event)" style="display:none;"/>
    <button class="demo-btn" onclick="loadDemo()">▶ サンプルCSVで試す（重複チェックも確認できます）</button>
    <div class="preview-wrap" id="preview-wrap">
      <div style="font-size:13px;font-weight:600;margin-bottom:8px;">読み取り結果 <span id="dup-note" style="font-size:11px;color:var(--color-danger);"></span></div>
      <div style="overflow-x:auto;">
        <table class="preview-table">
          <thead><tr><th>日付</th><th>内容</th><th>金額</th><th>カテゴリ</th><th></th></tr></thead>
          <tbody id="preview-tbody"></tbody>
        </table>
      </div>
    </div>
    <div class="import-summary" id="import-summary">
      <div class="sum-row"><span style="color:var(--color-text-secondary)">取り込み件数</span><span id="sum-count">0件</span></div>
      <div class="sum-row"><span style="color:var(--color-text-secondary)">重複除外</span><span id="sum-dup" style="color:var(--color-danger);">0件</span></div>
      <div class="sum-row"><span style="color:var(--color-text-secondary)">対象月</span><span id="sum-months">—</span></div>
      <div class="sum-total"><span>合計金額</span><span id="sum-total">¥0</span></div>
    </div>
    <button class="submit-btn" id="import-btn" onclick="doImport()" style="display:none;">この内容で取り込む</button>
  </div>
</div>

<!-- LOG -->
<div id="s-log" class="screen">
  <div class="hdr"><span class="hdr-title">履歴</span></div>
  <div id="tx-list" style="flex:1;overflow-y:auto;"></div>
</div>

<!-- ANNUAL -->
<div id="s-annual" class="screen">
  <div class="hdr">
    <span class="hdr-title">年間サマリー</span>
    <div class="month-sw">
      <button class="msw-btn" onclick="changeYear(-1)">‹</button>
      <span class="month-label" id="year-label">2026年</span>
      <button class="msw-btn" onclick="changeYear(1)">›</button>
    </div>
  </div>
  <div class="annual-body" id="annual-body"></div>
</div>

<!-- TREND -->
<div id="s-trend" class="screen">
  <div class="hdr"><span class="hdr-title">推移（12ヶ月）</span></div>
  <div class="trend-body">
    <div class="chart-wrap"><canvas id="trendChart"></canvas></div>
    <div id="trend-table-wrap"></div>
  </div>
</div>


<!-- BUDGET vs ACTUAL -->
<div id="s-budget-chart" class="screen">
  <div class="hdr">
    <span class="hdr-title">予算 vs 実績</span>
    <div class="month-sw">
      <button class="msw-btn" onclick="changeMonth(-1)">‹</button>
      <span class="month-label" id="bvc-month-label">12月</span>
      <button class="msw-btn" onclick="changeMonth(1)">›</button>
    </div>
  </div>
  <div class="trend-body">
    <div style="background:var(--color-bg-tertiary);border-radius:14px;padding:14px;margin-bottom:12px;">
      <div style="font-size:11px;color:var(--color-text-secondary);margin-bottom:6px;">凡例</div>
      <div style="display:flex;gap:16px;font-size:12px;">
        <span style="display:flex;align-items:center;gap:5px;"><span style="width:12px;height:12px;background:var(--chart-budget-fill);border-radius:2px;display:inline-block;"></span>予算</span>
