      <button id="pay-cash-btn" class="pay-btn" onclick="setPayment('cash')">💴 現金</button>
    </div>
    <button class="submit-btn" id="submit-btn" onclick="addExpense()">記録する</button>
    <!-- レシート読み取りはサブ機能として下部に -->
    <div style="text-align:center;margin-bottom:6px;color:var(--color-text-tertiary);font-size:12px;">— または —</div>
