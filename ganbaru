function guessCat(m){const s=(m||'').toLowerCase();for(const{k,c}of KW){if(k.some(w=>s.includes(w.toLowerCase())))return c;}return'amazon';}
function normalize(s){return(s||'').toLowerCase().replace(/[　\s\.co\.jp株式会社（）()\-]/g,'').replace(/[！-～]/g,c=>String.fromCharCode(c.charCodeAt(0)-0xFEE0));}
function int(s){return parseInt((s||'0').replace(/[,￥¥\s]/g,''))||0;}
function jpDate(s){
  if(!s)return'';s=s.trim();
  let m=s.match(/(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})/);if(m)return`${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;
  m=s.match(/(\d{2})[\/\-](\d{1,2})[\/\-](\d{1,2})/);if(m)return`20${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;
  m=s.match(/(\d{1,2})[\/\-](\d{1,2})/);if(m){const y=new Date().getFullYear();return`${y}-${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}`;}
  return s;
}

