    <div style="position:relative;width:100%;height:360px;margin-bottom:14px;"><canvas id="bvcChart2"></canvas></div>
    <div id="bvc-summary2"></div>
  </div>
</div>

<!-- SETTINGS -->
<div id="s-settings" class="screen">
