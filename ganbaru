async function fetchProposal(){
  const btn=document.getElementById('proposal-btn');
  const body=document.getElementById('proposal-body');
  const CATS=getCats(),b=loadBudgets();

  // 直近3ヶ月のデータを収集
  const months=[-3,-2,-1].map(n=>addMonths(cur,n));
  const monthNames=months.map(m=>{const[,mo]=m.split('-');return parseInt(mo)+'月';});

  // カテゴリ別3ヶ月平均を算出
  const catAvg={};
  Object.keys(CATS).forEach(k=>{
    const vals=months.map(m=>{
      const d=getMonthData(m);
      return (d.expenses||[]).filter(e=>e.cat===k).reduce((a,e)=>a+e.amount,0);
    });
    const nonZero=vals.filter(v=>v>0);
    catAvg[k]=nonZero.length>0?Math.round(vals.reduce((a,v)=>a+v,0)/nonZero.length):0;
  });

  const hasData=Object.values(catAvg).some(v=>v>0);
  if(!hasData){
    body.innerHTML='<p style="font-size:12px;color:var(--color-danger);">過去3ヶ月分のデータがありません。支出を記録してから再度お試しください。</p>';
    return;
  }

  btn.disabled=true;btn.textContent='分析中...';
  body.innerHTML='<div class="proposal-loading"><span class="spin"></span>AIが直近3ヶ月を分析中...</div>';

  // カテゴリ別データ文字列生成
  const catLines=Object.entries(CATS).map(([k,cat])=>{
    const avg=catAvg[k]||0;
    const bv=b[k]||0;
    const m1=(getMonthData(months[0]).expenses||[]).filter(e=>e.cat===k).reduce((a,e)=>a+e.amount,0);
    const m2=(getMonthData(months[1]).expenses||[]).filter(e=>e.cat===k).reduce((a,e)=>a+e.amount,0);
    const m3=(getMonthData(months[2]).expenses||[]).filter(e=>e.cat===k).reduce((a,e)=>a+e.amount,0);
    return `${cat.label}(${cat.fixed?'固定費':'変動費'}): ${monthNames[0]}¥${m1.toLocaleString()} / ${monthNames[1]}¥${m2.toLocaleString()} / ${monthNames[2]}¥${m3.toLocaleString()} / 現予算¥${bv.toLocaleString()} / 3ヶ月平均¥${avg.toLocaleString()}`;
  }).join('\n');

  const [,curMo]=cur.split('-');
  const prompt=`あなたはFP（ファイナルシャルプランナー）資格を持つ家計管理の専門家です。
クライアントの直近3ヶ月の支出実績をもとに、来月（${parseInt(curMo)}月）の最適な予算をカテゴリごとに提案してください。

【直近3ヶ月の支出実績と現在の予算】
${catLines}

【提案ルール】
- 固定費（家賃・駐車場）は現状維持（変更不要）
- 変動費は3ヶ月平均をベースに、トレンド・季節性を考慮して調整
- 予算オーバーが続くカテゴリは増額を検討
- 実績が予算を大きく下回るカテゴリは減額を検討（無理な削減は避ける）
- 1000円単位で丸める

以下のJSON形式のみで返してください。説明文・マークダウン不要。
{
  "proposals": [
    {
      "cat": "カテゴリキー",
      "amount": 提案金額(数値),
      "reason": "提案理由（20字以内）"
    }
  ],
  "summary": "全体的なコメント（50字以内）"
}`;

  try{
    const res=await fetch('https://api.anthropic.com/v1/messages',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        model:'claude-sonnet-4-20250514',
        max_tokens:800,
        system:'あなたはFP資格保有の家計管理専門家です。JSONのみで返答してください。',
        messages:[{role:'user',content:prompt}]
      })
    });
    const json=await res.json();
    const text=json.content.map(x=>x.text||'').join('').replace(/```json|```/g,'').trim();
    const result=JSON.parse(text);

    // 提案をwindowに保存（後でapplyに使う）
    window._proposalData=result;

    // レンダリング
    let html=`<div style="font-size:12px;color:#0C5C3A;background:#D5F0E5;border-radius:8px;padding:8px 10px;margin-bottom:10px;">💬 ${result.summary||''}</div>`;

    result.proposals.forEach(p=>{
      const cat=CATS[p.cat];if(!cat)return;
      const cur_b=b[p.cat]||0;
      const diff=p.amount-cur_b;
      const diffStr=diff===0?'変更なし':diff>0?`+¥${diff.toLocaleString()}`:`-¥${Math.abs(diff).toLocaleString()}`;
      const diffCls=diff>0?'up':diff<0?'down':'same';
      html+=`<div class="proposal-row">
        <span class="proposal-emoji">${cat.e}</span>
        <div class="proposal-label">
          <div style="font-size:13px;font-weight:500;">${cat.label}</div>
          <div class="proposal-reason">${p.reason||''}</div>
        </div>
        <div class="proposal-vals">
          <div class="proposal-new">¥${p.amount.toLocaleString()}</div>
          <div class="proposal-old">現在¥${cur_b.toLocaleString()}</div>
          <div class="proposal-diff ${diffCls}">${diffStr}</div>
        </div>
      </div>`;
    });

    html+=`<button class="proposal-apply-btn" onclick="applyProposal()">✅ この予算を適用する</button>`;
    body.innerHTML=html;

  }catch(err){
    body.innerHTML='<p style="font-size:12px;color:var(--color-danger);">⚠️ 提案の取得に失敗しました。もう一度お試しください。</p>';
  }
  btn.disabled=false;btn.textContent='再提案する';
}

function applyProposal(){
  if(!window._proposalData)return;
  const b=loadBudgets();
  window._proposalData.proposals.forEach(p=>{
    if(p.cat&&p.amount>0)b[p.cat]=p.amount;
  });
  saveBudgetsLS(b);
  renderBudgetFields();
  document.getElementById('proposal-card').style.display='none';
  showToast('予算を更新しました ✓','var(--color-success)');
}

function showToast(msg,bg){const t=document.createElement('div');t.className='toast';t.style.background=bg;t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),2200);}



