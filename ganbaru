    <button class="analyze-tab active" id="atab-annual" onclick="switchAnalyzeTab('annual')">年間</button>
    <button class="analyze-tab" id="atab-trend" onclick="switchAnalyzeTab('trend')">推移</button>
    <button class="analyze-tab" id="atab-budget" onclick="switchAnalyzeTab('budget')">予算比較</button>
  </div>
  <!-- 年間パネル -->
  <div id="apanel-annual" class="annual-body" id="annual-body" style="flex:1;overflow-y:auto;padding:0 14px 14px;"></div>
