<!DOCTYPE html>
<html lang="ja">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1"/>
<title>家計簿アプリ</title>
<!-- PWA -->
<link rel="manifest" href="manifest.json"/>
<meta name="mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-capable" content="yes"/>
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
<meta name="apple-mobile-web-app-title" content="家計簿"/>
<meta name="theme-color" content="#1558A8"/>
<link rel="apple-touch-icon" href="icon-192.png"/>
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png"/>
<link rel="icon" type="image/png" sizes="512x512" href="icon-512.png"/>

<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>

<style>
/* ============ ブランドカラー定義 ============ */
:root{
  /* Primary */
  --brand-primary:       #1558A8;
  --brand-primary-dark:  #0D3F7A;
  --brand-primary-light: #D8ECFF;
  --brand-primary-mid:   #3A7BD5;

  /* Semantic */
  --color-success:       #1A9E6E;
  --color-success-light: #D4F5E9;
  --color-warning:       #D97706;
  --color-warning-light: #FEF3C7;
  --color-danger:        #DC2626;
  --color-danger-light:  #FEE2E2;

  /* Neutral */
  --color-text-primary:   #111827;
  --color-text-secondary: #6B7280;
  --color-text-tertiary:  #9CA3AF;
  --color-text-inverse:   #FFFFFF;
  --color-bg-primary:     #FFFFFF;
  --color-bg-secondary:   #F8FAFC;
  --color-bg-tertiary:    #F1F5F9;
  --color-border:         #E5E7EB;
  --color-border-light:   #F3F4F6;

  /* Hero gradient */
  --hero-gradient: linear-gradient(135deg,#1558A8 0%,#1A7FC1 60%,#22A5C7 100%);

  /* Typography scale */
  --text-xs:   11px;
  --text-sm:   12px;
  --text-base: 14px;
  --text-md:   16px;
  --text-lg:   18px;
  --text-xl:   20px;
  --text-2xl:  24px;
  --text-3xl:  32px;
  --text-4xl:  40px;

  /* Line height */
  --leading-tight:  1.25;
  --leading-normal: 1.5;
  --leading-loose:  1.75;

  /* Spacing */
  --space-xs:  4px;
  --space-sm:  8px;
  --space-md:  14px;
  --space-lg:  20px;
  --space-xl:  28px;

  /* Radius */
  --radius-sm:  8px;
  --radius-md:  12px;
  --radius-lg:  16px;
  --radius-xl:  20px;
  --radius-full: 9999px;

  /* Shadow */
  --shadow-sm: 0 1px 4px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 16px rgba(0,0,0,0.10);
  --shadow-lg: 0 8px 32px rgba(0,0,0,0.14);

  /* Chart / data colors */
  --chart-bar-normal:  #85B7EB;
  --chart-bar-over:    var(--chart-bar-over);
  --chart-budget-fill: var(--chart-budget-fill);
  --chart-line-budget: #DC2626;

  /* Accent / misc */
  --color-gold:    var(--color-gold);
  --color-silver:  #8B9EB0;
  --color-bronze:  #A0714F;
  --color-divider: #F3F4F6;
}

/* ============ リセット & ベース ============ */
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;}
body{
  background:var(--color-bg-primary);
  font-family:'Noto Sans JP',-apple-system,BlinkMacSystemFont,'Hiragino Sans',sans-serif;
  color:var(--color-text-primary);
  font-size:var(--text-base);
  line-height:var(--leading-normal);
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
.app{max-width:390px;margin:0 auto;display:flex;flex-direction:column;position:relative;min-height:100svh;}
.screen{display:none;flex:1;flex-direction:column;padding-bottom:72px;overflow-y:auto;}
.screen.active{display:flex;}
.hdr{display:flex;align-items:center;justify-content:space-between;padding:16px 14px 8px;flex-shrink:0;}
.hdr-title{font-size:var(--text-xl);font-weight:800;color:var(--color-text-primary);letter-spacing:-.3px;}
.month-sw{display:flex;align-items:center;gap:4px;}
.msw-btn{width:34px;height:34px;border:1px solid var(--color-border);border-radius:var(--radius-sm);background:none;cursor:pointer;font-size:var(--text-lg);display:flex;align-items:center;justify-content:center;color:var(--color-text-secondary);}
.month-label{font-size:var(--text-base);font-weight:700;min-width:56px;text-align:center;letter-spacing:-.2px;}
.hero{margin:6px var(--space-md);background:var(--hero-gradient);border-radius:var(--radius-xl);padding:var(--space-lg) var(--space-lg) 18px;box-shadow:0 4px 20px rgba(19,86,168,0.25);}
.hero-label{font-size:var(--text-xs);font-weight:500;color:rgba(255,255,255,0.78);margin-bottom:var(--space-xs);letter-spacing:.06em;text-transform:uppercase;}
.hero-amount{font-size:var(--text-4xl);font-weight:800;color:var(--color-text-inverse);letter-spacing:-1.5px;line-height:var(--leading-tight);}
.hero-sub{font-size:var(--text-sm);color:rgba(255,255,255,0.78);margin-top:var(--space-xs);line-height:var(--leading-normal);}
.prog-track{height:8px;background:rgba(255,255,255,0.25);border-radius:4px;margin-top:12px;overflow:hidden;}
.prog-fill{height:8px;border-radius:4px;transition:width .6s cubic-bezier(.4,0,.2,1);}
.alert-area{padding:0 14px;margin-top:6px;}
.alert-card{display:flex;align-items:center;gap:10px;padding:12px var(--space-md);border-radius:var(--radius-lg);margin-bottom:var(--space-sm);font-size:var(--text-base);font-weight:600;line-height:var(--leading-normal);}
.alert-warn{background:linear-gradient(135deg,var(--color-warning-light),#FDE68A);color:var(--color-warning);border:1.5px solid #FCD34D;box-shadow:0 2px 8px rgba(217,119,6,0.15);}
.alert-over{background:linear-gradient(135deg,var(--color-danger-light),#FECACA);color:var(--color-danger);border:1.5px solid #FCA5A5;box-shadow:0 2px 8px rgba(220,38,38,0.15);}
.metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;padding:0 14px;margin-top:8px;}
.metric{background:var(--color-bg-primary);border-radius:var(--radius-md);padding:13px;box-shadow:var(--shadow-sm);border:1px solid var(--color-border-light);}
.metric-label{font-size:var(--text-xs);font-weight:500;color:var(--color-text-tertiary);margin-bottom:var(--space-xs);letter-spacing:.04em;}
.metric-val{font-size:var(--text-2xl);font-weight:800;letter-spacing:-.5px;line-height:var(--leading-tight);}
.sec-hdr{font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);padding:14px var(--space-md) var(--space-xs);letter-spacing:.12em;text-transform:uppercase;}
.cat-item{display:flex;align-items:center;gap:12px;padding:13px 14px;border-bottom:1px solid var(--color-bg-tertiary);transition:background .15s;}
.cat-emoji{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:21px;flex-shrink:0;}
.cat-mid{flex:1;min-width:0;}
.cat-name{font-size:var(--text-base);font-weight:600;line-height:var(--leading-tight);}
.bar-track{height:8px;background:var(--color-bg-tertiary);border-radius:4px;margin-top:6px;overflow:hidden;}
.bar-fill{height:8px;border-radius:4px;transition:width .5s cubic-bezier(.4,0,.2,1);}
.cat-right{text-align:right;flex-shrink:0;}
.cat-spent{font-size:var(--text-md);font-weight:700;letter-spacing:-.3px;line-height:var(--leading-tight);}
.cat-budget{font-size:var(--text-xs);color:var(--color-text-tertiary);margin-top:3px;line-height:var(--leading-tight);}
.bnav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:390px;display:flex;border-top:1px solid var(--color-border-light);background:var(--color-bg-primary);z-index:100;}
.bnav-btn{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;padding:7px 2px 9px;background:none;border:none;cursor:pointer;font-size:var(--text-xs);font-weight:600;color:var(--color-text-tertiary);min-height:54px;letter-spacing:.01em;}
.bnav-btn.active{color:var(--brand-primary);}
.nav-icon{font-size:22px;line-height:1;display:block;}
.scroll-body{padding:0 14px;flex:1;overflow-y:auto;}
.upload-box{border:1.5px dashed var(--color-border);border-radius:14px;padding:18px;display:flex;flex-direction:column;align-items:center;gap:6px;cursor:pointer;margin-bottom:12px;}
.upload-box i{font-size:30px;color:var(--brand-primary);}
.upload-lbl{font-size:14px;font-weight:600;color:var(--brand-primary);}
.upload-sub{font-size:11px;color:var(--color-text-tertiary);}
.preview-img{width:100%;border-radius:12px;object-fit:cover;max-height:130px;display:none;margin-bottom:10px;}
.ai-card{background:var(--color-bg-tertiary);border-radius:12px;padding:12px;margin-bottom:12px;display:none;}
.ai-badge{font-size:11px;font-weight:600;color:var(--brand-primary-dark);background:var(--brand-primary-light);padding:3px 8px;border-radius:99px;display:inline-flex;align-items:center;gap:4px;margin-bottom:8px;}
.ai-amount{font-size:24px;font-weight:700;margin-bottom:6px;}
.ai-tags{display:flex;flex-wrap:wrap;gap:5px;}
.ai-tag{font-size:11px;padding:3px 8px;border-radius:99px;}
.field{margin-bottom:11px;}
.field label{font-size:var(--text-sm);font-weight:600;color:var(--color-text-secondary);display:block;margin-bottom:var(--space-xs);letter-spacing:.02em;}
.field input,.field select{width:100%;font-size:var(--text-md);padding:12px;border:1.5px solid var(--color-border);border-radius:var(--radius-md);background:var(--color-bg-primary);color:var(--color-text-primary);line-height:var(--leading-normal);font-family:inherit;}
.pay-toggle{display:flex;gap:8px;margin-bottom:12px;}
.pay-btn{flex:1;padding:11px;border:1px solid var(--color-border);border-radius:10px;background:none;cursor:pointer;font-size:13px;font-weight:500;display:flex;align-items:center;justify-content:center;gap:5px;}
.pay-btn.sel-card{border-color:var(--brand-primary);background:var(--brand-primary-light);color:var(--brand-primary-dark);}
.pay-btn.sel-cash{border-color:var(--color-success);background:#d5f0e7;color:var(--color-success);}
.cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px;}
.cat-choice{padding:10px 6px;border:1.5px solid var(--color-border-light);border-radius:var(--radius-md);background:var(--color-bg-secondary);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:var(--space-xs);font-size:var(--text-xs);font-weight:700;text-align:center;transition:all .15s;color:var(--color-text-primary);line-height:var(--leading-tight);font-family:inherit;}
.cat-choice.selected{border-color:var(--brand-primary);background:linear-gradient(135deg,var(--brand-primary-light),#C2DCFF);color:var(--brand-primary-dark);box-shadow:0 2px 8px rgba(21,88,168,0.2);}
.cat-choice span{font-size:24px;}
.submit-btn{width:100%;padding:15px;background:var(--brand-primary);color:var(--color-text-inverse);border:none;border-radius:var(--radius-md);font-size:var(--text-md);font-weight:700;cursor:pointer;margin-bottom:var(--space-md);letter-spacing:.02em;font-family:inherit;}
.submit-btn:disabled{background:var(--color-border);cursor:not-allowed;}
.tx-item{display:flex;align-items:center;gap:10px;padding:11px 14px;border-bottom:1px solid var(--color-border-light);}
.tx-emoji{width:40px;height:40px;border-radius:50%;background:var(--color-bg-tertiary);display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.tx-mid{flex:1;min-width:0;}
.tx-name{font-size:var(--text-base);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:var(--leading-tight);}
.tx-meta{font-size:var(--text-xs);color:var(--color-text-tertiary);margin-top:3px;display:flex;align-items:center;gap:var(--space-xs);line-height:var(--leading-tight);}
.pay-tag{font-size:10px;padding:1px 5px;border-radius:4px;font-weight:600;}
.pay-tag-card{background:var(--brand-primary-light);color:var(--brand-primary-dark);}
.pay-tag-cash{background:#d5f0e7;color:var(--color-success);}
.tx-right{text-align:right;flex-shrink:0;}
.tx-amount{font-size:var(--text-base);font-weight:700;letter-spacing:-.2px;}
.tx-del{background:none;border:none;cursor:pointer;color:var(--color-border);padding:3px;display:block;margin-left:auto;}
.card-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:14px;}
.card-btn{padding:11px 8px;border:1px solid var(--color-border);border-radius:10px;background:none;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:5px;font-size:12px;font-weight:500;}
.card-btn.selected{border-color:var(--brand-primary);background:var(--brand-primary-light);color:var(--brand-primary-dark);}
.card-btn .ci{font-size:22px;}
.how-to{background:var(--color-bg-tertiary);border-radius:12px;padding:12px;margin-bottom:12px;}
.how-to-title{font-size:13px;font-weight:600;margin-bottom:6px;}
.how-to ol{padding-left:16px;}
.how-to li{font-size:12px;color:var(--color-text-secondary);margin-bottom:3px;line-height:1.5;}
.csv-drop{border:1.5px dashed var(--color-border);border-radius:12px;padding:18px;display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer;margin-bottom:10px;}
.csv-drop i{font-size:28px;color:var(--brand-primary);}
.csv-drop .lbl{font-size:14px;font-weight:600;color:var(--brand-primary);}
.csv-drop .sub{font-size:11px;color:var(--color-text-tertiary);text-align:center;}
.preview-wrap{background:var(--color-bg-tertiary);border-radius:12px;padding:11px;margin-bottom:11px;max-height:250px;overflow-y:auto;display:none;}
.preview-table{width:100%;border-collapse:collapse;font-size:11px;}
.preview-table th{text-align:left;padding:5px 3px;color:var(--color-text-secondary);font-weight:600;border-bottom:1px solid var(--color-border);}
.preview-table td{padding:5px 3px;border-bottom:1px solid var(--color-bg-tertiary);}
.cat-sel{font-size:11px;padding:2px 4px;border:1px solid var(--color-border);border-radius:4px;max-width:76px;}
.dup-flag{color:var(--color-danger);font-size:10px;font-weight:600;}
.import-summary{background:var(--color-bg-tertiary);border-radius:12px;padding:12px;margin-bottom:12px;display:none;}
.sum-row{display:flex;justify-content:space-between;font-size:13px;padding:3px 0;}
.sum-total{font-size:17px;font-weight:700;margin-top:7px;padding-top:7px;border-top:1px solid var(--color-border);display:flex;justify-content:space-between;}
.demo-btn{width:100%;padding:11px;background:none;border:1px solid var(--color-border);border-radius:10px;font-size:13px;color:var(--color-text-secondary);cursor:pointer;margin-bottom:10px;}
.trend-body{flex:1;overflow-y:auto;padding:0 14px 14px;}
.chart-wrap{position:relative;width:100%;height:200px;margin-bottom:14px;}
.trend-table{width:100%;border-collapse:collapse;font-size:13px;}
.trend-table th{text-align:left;padding:7px 5px;color:var(--color-text-secondary);font-weight:500;border-bottom:1px solid var(--color-border-light);}
.trend-table td{padding:7px 5px;border-bottom:1px solid var(--color-bg-tertiary);}
.annual-body{flex:1;overflow-y:auto;padding:0 14px 14px;}
.annual-hero{background:var(--color-bg-secondary);border-radius:var(--radius-lg);padding:var(--space-md) 18px;margin-bottom:12px;border:1px solid var(--color-border-light);}
.annual-hero .label{font-size:var(--text-xs);font-weight:500;color:var(--color-text-secondary);margin-bottom:var(--space-xs);letter-spacing:.04em;}
.annual-hero .amount{font-size:var(--text-3xl);font-weight:800;letter-spacing:-1px;line-height:var(--leading-tight);}
.annual-hero .sub{font-size:var(--text-sm);color:var(--color-text-secondary);margin-top:var(--space-xs);line-height:var(--leading-normal);}
.rank-item{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--color-border-light);}
.rank-no{font-size:15px;font-weight:700;width:22px;text-align:center;flex-shrink:0;color:var(--color-text-tertiary);}
.rank-no.gold{color:var(--color-gold);}.rank-no.silver{color:var(--color-text-secondary);}.rank-no.bronze{color:#A0714F;}
.rank-emoji{font-size:20px;flex-shrink:0;}
.rank-mid{flex:1;min-width:0;}
.rank-name{font-size:var(--text-base);font-weight:600;line-height:var(--leading-tight);}
.rank-bar-track{height:4px;background:var(--color-border);border-radius:2px;margin-top:4px;}
.rank-right{text-align:right;flex-shrink:0;}
.rank-amount{font-size:var(--text-base);font-weight:700;letter-spacing:-.2px;}
.rank-pct{font-size:var(--text-xs);color:var(--color-text-tertiary);margin-top:2px;}
.monthly-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:4px;}
.monthly-cell{background:var(--color-bg-tertiary);border-radius:10px;padding:10px 8px;text-align:center;}
.monthly-cell .mo{font-size:11px;color:var(--color-text-secondary);margin-bottom:3px;}
.monthly-cell .val{font-size:12px;font-weight:600;}
.monthly-cell .diff{font-size:10px;margin-top:2px;}
.settings-body{padding:0 14px;flex:1;overflow-y:auto;}
.bsec-hdr{font-size:var(--text-xs);font-weight:700;color:var(--color-text-tertiary);padding:14px 0 var(--space-xs);letter-spacing:.1em;text-transform:uppercase;}
.budget-row{display:flex;align-items:center;gap:9px;padding:9px 0;border-bottom:1px solid var(--color-border-light);}
.b-emoji{font-size:19px;width:26px;text-align:center;flex-shrink:0;}
.b-name{font-size:var(--text-base);font-weight:500;flex:1;line-height:var(--leading-normal);}
.b-input{width:90px;font-size:13px;padding:6px 8px;border:1px solid var(--color-border);border-radius:8px;text-align:right;}
.b-del{background:none;border:none;cursor:pointer;color:var(--color-border);padding:3px;flex-shrink:0;}
.save-btn{width:100%;padding:14px;background:var(--brand-primary);color:var(--color-text-inverse);border:none;border-radius:var(--radius-md);font-size:var(--text-md);font-weight:700;cursor:pointer;margin:10px 0 5px;letter-spacing:.02em;font-family:inherit;}
.add-cat-card{border:1px solid var(--color-border-light);border-radius:12px;padding:12px;margin-bottom:8px;}
.emoji-grid{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px;}
.emoji-opt{width:34px;height:34px;border:1px solid var(--color-border);border-radius:8px;background:none;cursor:pointer;font-size:17px;display:flex;align-items:center;justify-content:center;}
.emoji-opt.selected{border-color:var(--brand-primary);background:var(--brand-primary-light);}
.color-grid{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px;}
.color-opt{width:24px;height:24px;border-radius:50%;border:2px solid transparent;cursor:pointer;}
.color-opt.selected{border-color:var(--color-text-primary);}
.add-cat-btn{width:100%;padding:10px;background:none;border:1px solid var(--brand-primary);border-radius:10px;color:var(--brand-primary);font-size:13px;font-weight:600;cursor:pointer;}
.empty{text-align:center;padding:2rem 1rem;font-size:var(--text-base);color:var(--color-text-tertiary);line-height:var(--leading-normal);}
.spin{display:inline-block;width:13px;height:13px;border:2px solid var(--color-border);border-top-color:var(--brand-primary);border-radius:50%;animation:spin .7s linear infinite;}
@keyframes spin{to{transform:rotate(360deg);}}
.diff-pos{color:var(--color-success);}.diff-neg{color:var(--color-danger);}

.advice-area{padding:0 14px;margin-top:8px;}
.advice-card{background:linear-gradient(135deg,#EAF3FB,#F0F7FF);border:1px solid #C8DFF5;border-radius:14px;padding:14px;margin-bottom:8px;}
.advice-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.advice-title{font-size:var(--text-base);font-weight:700;color:var(--brand-primary-dark);display:flex;align-items:center;gap:6px;}
.advice-btn{font-size:12px;padding:5px 12px;background:var(--brand-primary);color:#fff;border:none;border-radius:99px;cursor:pointer;font-weight:600;white-space:nowrap;}
.advice-btn:disabled{background:var(--color-text-tertiary);cursor:not-allowed;}
.advice-body{font-size:var(--text-base);color:var(--color-text-primary);line-height:var(--leading-loose);}
.advice-body.loading{color:var(--color-text-secondary);display:flex;align-items:center;gap:8px;}
.advice-points{margin-top:8px;padding-top:8px;border-top:1px solid #C8DFF5;}
.advice-point{display:flex;gap:6px;margin-bottom:5px;font-size:13px;line-height:1.5;}
.advice-point-icon{flex-shrink:0;font-size:15px;}


/* オンボーディング */
.onboard-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:500;display:flex;align-items:flex-end;justify-content:center;}
.onboard-sheet{background:#fff;border-radius:20px 20px 0 0;padding:28px 24px 36px;width:100%;max-width:390px;animation:slideUp .35s ease;}
@keyframes slideUp{from{transform:translateY(100%);}to{transform:translateY(0);}}
.onboard-icon{font-size:44px;text-align:center;margin-bottom:12px;}
.onboard-title{font-size:var(--text-xl);font-weight:800;text-align:center;margin-bottom:var(--space-sm);letter-spacing:-.3px;}
.onboard-desc{font-size:var(--text-base);color:var(--color-text-secondary);text-align:center;line-height:var(--leading-loose);margin-bottom:var(--space-lg);}
.onboard-steps{display:flex;flex-direction:column;gap:10px;margin-bottom:24px;}
.onboard-step{display:flex;align-items:center;gap:12px;background:var(--color-bg-tertiary);border-radius:12px;padding:10px 14px;}
.onboard-step-no{width:26px;height:26px;border-radius:50%;background:var(--brand-primary);color:#fff;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.onboard-step-text{font-size:var(--text-base);font-weight:500;line-height:var(--leading-normal);}
.onboard-start-btn{width:100%;padding:15px;background:var(--brand-primary);color:var(--color-text-inverse);border:none;border-radius:var(--radius-lg);font-size:var(--text-md);font-weight:700;cursor:pointer;font-family:inherit;letter-spacing:.02em;}

/* 記録完了アニメーション */
.success-overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:600;pointer-events:none;}
.success-badge{background:#fff;border-radius:20px;padding:20px 32px;display:flex;flex-direction:column;align-items:center;gap:8px;box-shadow:0 8px 32px rgba(0,0,0,0.15);animation:popIn .4s cubic-bezier(.175,.885,.32,1.275);}
@keyframes popIn{from{transform:scale(.6);opacity:0;}to{transform:scale(1);opacity:1;}}
.success-badge .s-icon{font-size:40px;}
.success-badge .s-text{font-size:15px;font-weight:700;color:var(--color-success);}
.success-badge .s-amount{font-size:22px;font-weight:700;color:var(--color-text-primary);}

/* スワイプ削除 */
.tx-item{position:relative;overflow:hidden;transition:transform .25s;}
.tx-del-bg{position:absolute;right:0;top:0;bottom:0;width:80px;background:var(--color-danger);display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:600;}

/* 残り日数バッジ */
.days-badge{display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--color-bg-tertiary);border-radius:12px;margin:8px 14px 0;font-size:13px;}
.days-badge .days-num{font-size:22px;font-weight:700;color:var(--brand-primary);}
.days-badge .days-label{color:var(--color-text-secondary);font-size:12px;margin-top:2px;}
.days-badge .daily-budget{font-size:13px;font-weight:600;color:var(--color-success);margin-left:auto;}

/* 分析タブ統合画面 */
.analyze-tabs{display:flex;gap:0;margin:0 14px 14px;border-radius:10px;overflow:hidden;border:1px solid var(--color-border);}
.analyze-tab{flex:1;padding:9px 4px;background:none;border:none;cursor:pointer;font-size:13px;font-weight:500;color:var(--color-text-secondary);}
.analyze-tab.active{background:var(--brand-primary);color:#fff;}


/* 予算自動提案カード */
.proposal-card{background:linear-gradient(135deg,#F0F7FF,#EAF7F0);border:1px solid #B8D8F0;border-radius:14px;padding:14px;margin-bottom:12px;}
.proposal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;}
.proposal-title{font-size:13px;font-weight:700;color:#0C5C3A;display:flex;align-items:center;gap:6px;}
.proposal-ai-btn{font-size:12px;padding:5px 12px;background:var(--color-success);color:#fff;border:none;border-radius:99px;cursor:pointer;font-weight:600;}
.proposal-ai-btn:disabled{background:var(--color-text-tertiary);cursor:not-allowed;}
.proposal-row{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid #D5EDE4;}
.proposal-row:last-child{border-bottom:none;}
.proposal-emoji{font-size:18px;width:26px;text-align:center;flex-shrink:0;}
.proposal-label{font-size:13px;flex:1;}
.proposal-vals{text-align:right;flex-shrink:0;}
.proposal-new{font-size:15px;font-weight:700;color:var(--brand-primary);}
.proposal-old{font-size:11px;color:var(--color-text-tertiary);margin-top:1px;}
.proposal-diff{font-size:11px;font-weight:600;margin-top:1px;}
.proposal-diff.up{color:var(--color-danger);}
.proposal-diff.down{color:var(--color-success);}
.proposal-diff.same{color:var(--color-text-tertiary);}
.proposal-apply-btn{width:100%;padding:12px;background:var(--brand-primary);color:#fff;border:none;border-radius:12px;font-size:15px;font-weight:600;cursor:pointer;margin-top:10px;}
.proposal-loading{text-align:center;padding:16px;color:var(--color-text-secondary);font-size:13px;display:flex;align-items:center;justify-content:center;gap:8px;}
.proposal-reason{font-size:11px;color:var(--color-text-secondary);margin-top:2px;line-height:1.4;}

.toast{position:fixed;bottom:78px;left:50%;transform:translateX(-50%);padding:9px 20px;border-radius:99px;font-size:13px;font-weight:600;white-space:nowrap;z-index:999;color:#fff;}
</style>
</head>
<body>
<div class="app">

<!-- HOME -->
<div id="s-home" class="screen active">
  <div class="hdr">
    <span class="hdr-title">家計簿</span>
    <div class="month-sw">
      <button class="msw-btn" onclick="changeMonth(-1)">‹</button>
      <span class="month-label" id="month-label">6月</span>
      <button class="msw-btn" onclick="changeMonth(1)">›</button>
    </div>
  </div>
  <div class="hero">
    <div class="hero-label">今月の支出</div>
